{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trenbolon.malakhov.su/workout-import.schema.json",
  "title": "Trenbolon workout import",
  "description": "Конверт импорта/экспорта тренировок. Внутренние ID не используются.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workouts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "workouts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/workout"
      }
    }
  },
  "$defs": {
    "workout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "title",
        "restSeconds",
        "soundEnabled",
        "exercises"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "\\S",
          "description": "Не пустая строка (пробелы по краям обрезаются)."
        },
        "title": {
          "type": "string",
          "pattern": "\\S",
          "description": "Не пустая строка (пробелы по краям обрезаются)."
        },
        "restSeconds": {
          "enum": [
            60,
            90,
            120,
            180
          ],
          "description": "Секунды отдыха."
        },
        "soundEnabled": {
          "type": "boolean"
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/exercise"
          }
        }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sets",
        "reps",
        "weight"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S",
          "description": "Не пустая строка (пробелы по краям обрезаются)."
        },
        "sets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Число подходов."
        },
        "setOptions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "description": "Варианты числа подходов; должен содержать значение sets (это не выражается в JSON Schema и проверяется приложением)."
        },
        "reps": {
          "type": "string",
          "pattern": "\\S",
          "description": "Свободная строка: 10, 12–15, до отказа."
        },
        "weight": {
          "type": "string",
          "description": "Свободная строка, может быть пустой."
        }
      }
    }
  }
}
